# This is an example file. To use it for local development in Firebase Studio,
# follow these steps:
# 1. In the file explorer on the left, rename this file from .env.local.example to .env.local
# 2. Get your private key from Google Cloud Secret Manager for this project.
# 3. Paste the entire key into the FIREBASE_ADMIN_PRIVATE_KEY variable below, replacing the placeholder text.
#
# Firebase Studio will automatically detect the .env.local file and use these credentials,
# enabling admin actions like voting to work correctly in the preview.

FIREBASE_ADMIN_PROJECT_ID="act-local-glow"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-fbsvc@act-local-glow.iam.gserviceaccount.com"

# PASTE YOUR FULL PRIVATE KEY INSIDE THE QUOTES BELOW.
# It should start with "-----BEGIN PRIVATE KEY-----" and end with "-----END PRIVATE KEY-----".
FIREBASE_ADMIN_PRIVATE_KEY="<PASTE_YOUR_SECRET_KEY_HERE>"
